# Test output (screenshots, audio captures, logs)
scripts/tests/output/
# Overnight integration/independence sweep artifacts (100MB+ of per-tool screenshots/
# metrics/reports; regenerate via scripts/tests/overnight_integration.py). The human
# summary lives in memory + TODO.overnight.md, not the repo.
scripts/tests/overnight_results/

# Local tooling / per-machine state (not shared)
.claude/settings.json
.superpowers/

# Windows Explorer folder metadata
desktop.ini
**/desktop.ini

# audio/Finals/ = 42MB of working "final" mixes; only audio/*.mp3 (top level) ship
# via embed_audio. Keep the working folder local.
audio/Finals/

# Session scratch notes (not project docs)
/challenge food groups.txt
/puzzle handoff.md

# Build tools (large binaries, download locally)
tools/
scripts/tests/__pycache__/

# UI screenshot capture working files (we keep PNGs, drop the raw RGB565 dumps)
shots/*.raw
shots/_historical_*
images/_stage_tmp/

# images/hires_src/ is the SOURCE OF TRUTH for collectible art (the whole publish
# pipeline points at it) -- the .png masters are TRACKED. Backup archives and scratch
# artifacts inside it are NOT (a 106MB .7z snapshot there blew GitHub's 100MB limit).
images/hires_src/*.7z
images/hires_src/*.a8
images/hires_src/_*
# Backup archives never belong in git history
*.7z

# DERIVED image outputs (regenerated by publish_collectibles.sh / build scripts).
images/processed/
images/review/

# Local debug / JTAG artifacts (OpenOCD cfg, SVD, debug screenshots)
/debug*
/dbg_tools.png

# --rift boot screen: private/user art is local-only. The committed
# rift_boot_placeholder.c is the public default ("CUSTOM BOOT SCREEN").
# Generate your own with scripts/build_rift_screens.py.
rift_loading_img.c
rift_clippy_img.c
rift_art_present.h
images/rift/

# Build artifacts (arduino-cli --build-path output)
build/

# Generated per-build stamp (DC34-122; scripts/build.sh regenerates it)
build_stamp.h

# Release binaries (large; generate with scripts/make_release_bins.sh)
release/*
# ...except the tiny build-derived flash recipe web_flash consumes (DC34-114)
!release/flash-spec.json
# ...and the signed checksum manifest + signature: committed so the flasher can
# fetch them cross-origin (raw.githubusercontent) and verify the Ed25519 sig
# against the pinned pubkey (DC34-122/123). The bins themselves stay ignored
# (web_flash distributes; rift bins are gated, never public).
!release/SHA256SUMS
!release/SHA256SUMS.minisig

# Internal counsel correspondence - never commit (repo may go public on GPLv3 source release)
for_counsel.md

# Release signing PRIVATE keys - NEVER commit (DC34-122). The private key lives
# only in a password manager on the signing box; only keys/clipboy-release.pub
# (the public trust anchor) is tracked.
keys/*.key
keys/*.sec
*-release.key
minisign.key

# Python cache
__pycache__/
*.pyc

# Generated badge screenshots (deliverables, not source)
shots/*.bmp
shots/*.png
shots/ks_themes/
# The harness auto-captures the framebuffer on every failure/skip into shots/failures/.
# The globs above do NOT recurse, so without this a suite run leaves untracked BMP+PNG pairs
# that get swept into the next `git add` -- transient diagnostics, not artefacts to version.
shots/failures/

# Generated DC34-92 SD save-file test fixtures (reproduce via make_sav_fixtures.py)
scripts/tests/sav_fixtures/

# Radio PCM spike — generated test asset (regenerate via scripts/audio_to_pcm.py)
radio_test_pcm.c
/stillalive.mp3
/radio_test.mp3

# Collectibles PROGMEM header — generated from data/collectibles.csv by build.sh
collectibles_csv.h

# Radio audio PROGMEM manifest — generated from audio/*.mp3 by scripts/embed_audio.py
radio_audio_gen.cpp
radio_audio_gen.h
# littlefs image (big radio beds) + its staging dir — built by build.sh (mklittlefs)
clipboy-littlefs.bin
build_littlefs/
# superseded by the audio pipeline (manual single-clip embed)
radio_1_1_mp3.c
radio_1_1_mp3.h

# Creds
secret.h
CLIP-BOY*SECRET*.md
*.secret.md
.obsidian/workspace.json
# MSVC host-repro build artifacts
*.pdb

# KS-exclusive rift colorways (local-only; copied into Clip-Boy-KS staging)
rift_private.h

# autonomous signing creds (rotated key) -- NEVER commit
sign_creds.local
scripts/sign_creds.local

# batch flasher runtime artifacts
scripts/production/nvs_blank.bin
scripts/production/spiffs_blank.bin
scripts/production/flash_log.jsonl
scripts/production/flash_log.csv
